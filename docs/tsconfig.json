{
    "extends": "@esportsplus/typescript/tsconfig.browser.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": "..",
        "paths": {
            "@esportsplus/ui/layer.scss": [
                "../layer.scss"
            ],
            "@esportsplus/ui/package.json": [
                "../package.json"
            ],
            "@esportsplus/ui/svg/*": [
                "../storage/svg/*"
            ],
            "@esportsplus/ui/*": [
                "../src/*"
            ],
            "docs/*": [
                "./src/*"
            ],
            "~/*": [
                "../src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "../vite-env.d.ts"
    ]
}
