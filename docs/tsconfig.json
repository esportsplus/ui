{
    "extends": "@esportsplus/typescript/tsconfig.browser.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": "..",
        "paths": {
            "~/components/*": [
                "../src/components/*"
            ],
            "~/css-utilities/*": [
                "../src/css-utilities/*"
            ],
            "~/shared/*": [
                "../src/shared/*"
            ],
            "~/*": [
                "./src/*"
            ],
            "@esportsplus/ui": [
                "../src/components/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "../vite-env.d.ts"
    ]
}
