{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/action": "^0.1.8",
        "@esportsplus/queue": "^0.4.6",
        "@esportsplus/reactivity": "^0.36.7",
        "@esportsplus/template": "^0.46.6",
        "@esportsplus/utilities": "^0.28.4",
        "modern-normalize": "^3.0.1"
    },
    "devDependencies": {
        "@esportsplus/typescript": "^0.34.4",
        "@types/node": "^26.6.1",
        "@types/shelljs": "^0.10.0",
        "autoprefixer": "^10.6.1",
        "glob": "^13.0.6",
        "lightningcss": "^1.33.0",
        "npm-run-all": "^4.1.5",
        "postcss": "8.5.28",
        "postcss-scss": "4.0.9",
        "sass": "^1.104.1",
        "shelljs": "^0.10.0",
        "vite": "^8.3.0"
    },
    "exports": {
        "./css-utilities.scss": "./build/css-utilities/index.scss",
        "./css-utilities/*.scss": "./build/css-utilities/*/scss/index.scss",
        "./css-utilities/font/*.scss": "./build/css-utilities/font/*/scss/index.scss",
        "./layer.scss": "./layer.scss",
        "./lib.scss": "./lib.scss",
        "./themes/dark": {
            "types": "./build/themes/dark/index.d.ts",
            "default": "./build/themes/dark/index.js"
        },
        "./themes/dark/*.scss": "./build/themes/dark/*/scss/index.scss",
        "./themes/light": {
            "types": "./build/themes/light/index.d.ts",
            "default": "./build/themes/light/index.js"
        },
        "./themes/light/*.scss": "./build/themes/light/*/scss/index.scss",
        "./tokens.scss": "./tokens.scss",
        "./*.scss": "./build/components/*/scss/index.scss",
        "./*": {
            "types": "./build/components/*/index.d.ts",
            "default": "./build/components/*/index.js"
        },
        ".": {
            "types": "./build/components/index.d.ts",
            "default": "./build/components/index.js"
        }
    },
    "name": "@esportsplus/ui",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/ui"
    },
    "scripts": {
        "build": "run-s build:vite build:ts",
        "build:ts": "tsc",
        "build:vite": "vite build",
        "-": "-",
        "dev": "pnpm --dir docs dev",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build"
    },
    "sideEffects": [
        "**/*.scss"
    ],
    "type": "module",
    "version": "0.53.0"
}
