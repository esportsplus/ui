{
    "author": "ICJR",
    "dependencies": {
        "@esportsplus/action": "^0.1.10",
        "@esportsplus/reactivity": "^0.43.0",
        "@esportsplus/template": "^0.61.0",
        "@esportsplus/utilities": "^0.28.8",
        "@esportsplus/workers": "^0.11.5",
        "modern-normalize": "^3.0.1"
    },
    "devDependencies": {
        "@esportsplus/typescript": "^0.42.0",
        "@esportsplus/vite": "^0.16.1",
        "@types/node": "^26.6.6",
        "@types/shelljs": "^0.10.0",
        "autoprefixer": "^10.6.2",
        "glob": "^14.0.3",
        "lightningcss": "^1.33.0",
        "npm-run-all": "^4.1.5",
        "postcss": "8.5.32",
        "postcss-scss": "4.0.9",
        "shelljs": "^0.10.0"
    },
    "exports": {
        "./css-utilities/*.scss": "./src/css-utilities/*.scss",
        "./css-utilities/font/*.scss": "./src/css-utilities/font/*/index.scss",
        "./layer.scss": "./layer.scss",
        "./modifiers": {
            "types": "./build/modifiers/index.d.ts",
            "default": "./build/modifiers/index.js"
        },
        "./modifiers/*": {
            "types": "./build/modifiers/*/index.d.ts",
            "default": "./build/modifiers/*/index.js"
        },
        "./normalize.scss": "./build/normalize/scss/index.scss",
        "./shared.scss": "./shared.scss",
        "./svg/*.svg": "./storage/svg/*.svg",
        "./tokens.scss": "./tokens.scss",
        "./*.scss": "./build/components/*/scss/index.scss",
        "./*": {
            "types": "./build/components/*/index.d.ts",
            "default": "./build/components/*/index.js"
        },
        ".": {
            "types": "./build/components/index.d.ts",
            "default": "./build/components/index.js"
        }
    },
    "name": "@esportsplus/ui",
    "private": false,
    "repository": {
        "type": "git",
        "url": "https://github.com/esportsplus/ui"
    },
    "scripts": {
        "build": "run-s build:vite build:ts",
        "build:ts": "tsc",
        "build:vite": "vite build",
        "-": "-",
        "dev": "pnpm --dir docs dev",
        "prepare": "pnpm build",
        "prepublishOnly": "pnpm build"
    },
    "sideEffects": [
        "**/*.scss"
    ],
    "type": "module",
    "version": "0.63.0"
}
